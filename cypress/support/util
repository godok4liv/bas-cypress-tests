Cypress.Commands.add('generateDynamicName', (prefix = 'Test') => {
  const businessName = `${prefix}-${Cypress._.random(100, 999)}`;
  // Log the generated name to the Cypress command log for visibility
  Cypress.log({
    name: 'generateDynamicName',
    message: businessName,
  });
  return businessName;
});


